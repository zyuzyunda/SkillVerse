# Для работы приложения на хосте против Postgres в Docker (порт 5433).
DATABASE_URL=postgresql+psycopg2://competence:competence@localhost:5433/competence_platform

# hh.ru API — зарегистрируйте приложение на https://dev.hh.ru
# User-Agent строго: AppName/Version (email@domain.com)
HH_USER_AGENT=SkillVerse/1.0 (contact@example.com)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Опционально: готовый access_token приложения из https://dev.hh.ru/admin
# HH_ACCESS_TOKEN=
HH_AREA=113
HH_REQUEST_DELAY_SEC=0.45
HH_MAX_PAGES_PER_QUERY=20
HH_PER_PAGE=100
# Нижняя граница published_at для API-поиска (активные вакансии с этой даты)
HH_DATE_FROM=2025-01-01

GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# auto = Groq, при 403 → локальная Ollama (Llama без VPN)
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Опционально OpenAI-compatible (OpenRouter и т.п.):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

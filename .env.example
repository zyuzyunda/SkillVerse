# Для работы приложения на хосте против Postgres в Docker (порт 5433).
DATABASE_URL=postgresql+psycopg2://competence:competence@localhost:5433/competence_platform
HH_USER_AGENT=CompetencePlatform/1.0 (zyuzyunda@gmail.com)
HH_AREA=113
HH_REQUEST_DELAY_SEC=0.6
HH_MAX_PAGES_PER_QUERY=25
HH_PER_PAGE=50
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# auto = Groq, при 403 → локальная Ollama (Llama без VPN)
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Опционально OpenAI-compatible (OpenRouter и т.п.):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
